#!/usr/bin/env bash
# Refuse a commit whose staged C sources do not match .clang-format.
# Checks the STAGED content, not the working tree: those differ whenever only
# part of a file is staged, and checking the wrong one gives both false
# failures and false passes.
#
# This hook never rewrites your files. Formatting is your call to make, so
# that nothing lands in a commit you did not look at.
#
# Enabled by: git config core.hooksPath .githooks
set -uo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 0

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM -- 'src/*.c' 'src/*.h')
[ "${#staged[@]}" -gt 0 ] || exit 0

if ! command -v clang-format >/dev/null 2>&1; then
    echo "clang-format не найден, а в коммите есть файлы из src/." >&2
    echo "  sudo apt-get install -y clang-format" >&2
    echo "Обойти: git commit --no-verify" >&2
    exit 1
fi

bad=()
for f in "${staged[@]}"; do
    staged_blob="$(git show ":$f")" || continue
    formatted="$(printf '%s\n' "$staged_blob" | clang-format --assume-filename="$f" --style=file)"
    [ "$staged_blob" = "$formatted" ] || bad+=("$f")
done

if [ "${#bad[@]}" -gt 0 ]; then
    echo "Не отформатировано по .clang-format:" >&2
    printf '  %s\n' "${bad[@]}" >&2
    echo >&2
    echo "  clang-format -i ${bad[*]}" >&2
    echo "затем повторно git add. Обойти: git commit --no-verify" >&2
    exit 1
fi
